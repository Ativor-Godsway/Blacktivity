    "typecheck": "tsc --noEmit",
    "audit:colour": "node scripts/audit-colour.mjs",
    "audit:motion": "node scripts/visual/reduced-motion.mjs ./.shots",
    "audit:grain": "node scripts/visual/grain-check.mjs",
    "shots": "node scripts/visual/shot.mjs",
    "perf:scroll": "node scripts/visual/scroll-perf.mjs",
    "audit:perf": "node scripts/audit-perf.mjs",
    "build:grain": "node scripts/build/make-grain.mjs",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:admin-colour": "node scripts/audit-admin-colour.mjs",
    "audit": "npm run audit:colour && npm run audit:admin-colour && npm run audit:perf && npm run audit:images && npm run test:render",
    "test:render": "tsx --tsconfig tests/tsconfig.json tests/tiptap-render.test.tsx",
    "check:wordmark": "node scripts/visual/wordmark-check.mjs",
    "check:raf": "node scripts/visual/raf-check.mjs",
    "audit:text": "node scripts/audit-text.mjs",
    "check:sparks": "node scripts/visual/spark-check.mjs",
    "check:text": "node scripts/visual/text-copy-check.mjs",
    "audit:all": "npm run audit:colour && npm run audit:contrast && npm run audit:admin-colour && npm run audit:perf && npm run audit:images && npm run audit:text && npm run audit:navigation && npm run test:render && npm run check:wordmark && npm run check:text && npm run check:raf && npm run check:cards && npm run check:opening",
    "audit:navigation": "node scripts/audit-navigation.mjs",
    "check:opening": "node scripts/visual/check-opening.mjs",
    "check:cards": "node scripts/visual/check-cards.mjs",
    "check:console": "node scripts/visual/console-sweep.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs"
  },
  "dependencies": {
