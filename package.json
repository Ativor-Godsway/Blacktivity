{
  "name": "blacktivity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build/stamp-stylesheet.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build/stamp-stylesheet.mjs && node scripts/build/check-cover.mjs && node scripts/build/check-rotation-image.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx scripts/seed.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:rotation": "tsx scripts/seed-rotation-only.ts",
    "dev:mongo": "tsx scripts/dev-mongo.ts",
    "typecheck": "tsc --noEmit",
    "audit:colour": "node scripts/audit-colour.mjs",
    "audit:motion": "node scripts/visual/reduced-motion.mjs ./.shots",
    "audit:grain": "node scripts/visual/grain-check.mjs",
    "shots": "node scripts/visual/shot.mjs",
    "perf:scroll": "node scripts/visual/scroll-perf.mjs",
    "audit:perf": "node scripts/audit-perf.mjs",
    "build:grain": "node scripts/build/make-grain.mjs",
    "build:rotation-figure": "node scripts/build/make-rotation-figure.mjs",
    "check:rotation-figure": "node scripts/build/make-rotation-figure.mjs --check",
    "check:cover": "node scripts/build/check-cover.mjs --check",
    "cover:placeholders": "node scripts/build/make-cover-placeholders.mjs",
    "check:cover-layout": "node scripts/visual/check-cover-layout.mjs",
    "check:cover-render": "node scripts/visual/check-cover-render.mjs",
    "check:themes": "node scripts/visual/check-themes.mjs",
    "check:rotation-image": "node scripts/build/check-rotation-image.mjs",
    "check:rotation-contrast": "node scripts/visual/check-rotation-contrast.mjs",
    "check:rotation-disc": "node scripts/visual/check-rotation-disc.mjs",
    "diagnose:hero": "node scripts/diagnose-hero.mjs",
    "stamp:css": "node scripts/build/stamp-stylesheet.mjs",
    "check:stamp": "node scripts/build/stamp-stylesheet.mjs --check",
    "check:devonly": "node scripts/build/check-devonly.mjs",
    "test:hero": "node scripts/visual/test-hero.mjs",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:admin-colour": "node scripts/audit-admin-colour.mjs",
    "audit": "npm run audit:colour && npm run audit:admin-colour && npm run audit:perf && npm run audit:images && npm run check:cover && npm run check:rotation-image && npm run check:stamp && npm run check:devonly && npm run test:render && npm run test:seed-admin",
    "test:render": "tsx --tsconfig tests/tsconfig.json tests/tiptap-render.test.tsx",
    "check:wordmark": "node scripts/visual/wordmark-check.mjs",
    "check:raf": "node scripts/visual/raf-check.mjs",
    "audit:text": "node scripts/audit-text.mjs",
    "check:sparks": "node scripts/visual/spark-check.mjs",
    "check:text": "node scripts/visual/text-copy-check.mjs",
    "audit:all": "npm run audit:colour && npm run audit:contrast && npm run audit:admin-colour && npm run audit:perf && npm run audit:images && npm run audit:text && npm run audit:navigation && npm run test:render && npm run check:wordmark && npm run check:text && npm run check:raf && npm run check:cover && npm run check:cover-render && npm run check:cover-layout && npm run check:themes && npm run check:rotation-image && npm run check:rotation-contrast && npm run check:rotation-disc && npm run check:cards && npm run check:opening",
    "audit:navigation": "node scripts/audit-navigation.mjs",
    "check:opening": "node scripts/visual/check-opening.mjs",
    "check:cards": "node scripts/visual/check-cards.mjs",
    "check:console": "node scripts/visual/console-sweep.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "test:seed-admin": "tsx --tsconfig tests/tsconfig.json tests/seed-admin.test.ts",
    "test:admin-login": "node tests/e2e/admin-login.e2e.mjs",
    "test:admin-password": "node tests/e2e/admin-password.e2e.mjs",
    "test:nav": "node tests/e2e/nav.e2e.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "jose": "^6.2.10",
    "lenis": "^1.3.26",
    "mongoose": "^9.9.4",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "next-cloudinary": "^6.18.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^17.4.2",
    "lighthouse": "^13.4.1",
    "mongodb-memory-server": "^11.2.0",
    "puppeteer-core": "^25.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
